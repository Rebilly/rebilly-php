<?xml version="1.0"?>
<psalm
    errorLevel="4"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
>
    <projectFiles>
        <directory name="src" />
        <directory name="examples" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <UnusedClass>
            <errorLevel type="suppress">
                <file name="src/CombinedService.php" />
                <file name="src/Service.php" />
                <referencedClass name="Rebilly\Sdk\Model\AuthenticationTokenFactory" />
                <referencedClass name="Rebilly\Sdk\Model\PayoutRequestAllocationOperationRequestFactory" />
                <referencedClass name="Rebilly\Sdk\Model\PayoutRequestBatchOperationRequestFactory" />
                <referencedClass name="Rebilly\Sdk\Model\PostFileRequestFactory" />
                <referencedClass name="Rebilly\Sdk\Model\PostKycDocumentMatchesRequestFactory" />
                <referencedClass name="Rebilly\Sdk\Model\PostPaymentInstrumentRequestFactory" />
                <referencedClass name="Rebilly\Sdk\Model\PostPayoutRequestBatchRequestFactory" />
                <referencedClass name="Rebilly\Sdk\Model\PostReadyToPayFactory" />
                <referencedClass name="Rebilly\Sdk\Model\PostReadyToPayRequestFactory" />
                <referencedClass name="Rebilly\Sdk\Model\PostServiceCredentialRequestFactory" />
            </errorLevel>
        </UnusedClass>
        <PossiblyUnusedMethod errorLevel="suppress"/>
        <PossiblyUnusedParam errorLevel="suppress"/>
        <UnusedMethod errorLevel="suppress"/>
        <PossiblyUnusedReturnValue errorLevel="suppress"/>
        <ForbiddenCode errorLevel="suppress"/>
        <MissingOverrideAttribute errorLevel="suppress"/>
    </issueHandlers>
</psalm>
